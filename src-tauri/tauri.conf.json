{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapr",
  "version": "1.3.0",
  "identifier": "com.quanvudev.snapr",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snapr",
        "width": 480,
        "height": 300,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jun",
    "copyright": "© 2026 Jun",
    "homepage": "https://github.com/quanvudev/snapr",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
