{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapr",
  "version": "1.13.0",
  "identifier": "com.quanvudev.snapr",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snapr",
        "width": 480,
        "height": 300,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "dragDropEnabled": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jun",
    "copyright": "© 2026 Jun",
    "homepage": "https://github.com/quanvudev/snapr-releases",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRDVDMEQ1QjE2N0E3N0IKUldSN3AyZXgxY0RWa2h3UElnM0J1cW4yM21JMStaelJxQkNCeTBNbmczaHFmNnNnRDlYdGF2WmYK"
    }
  }
}
